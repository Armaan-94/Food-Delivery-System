# Copy to .env (never commit it) and fill in every value. Used by docker-compose, and as the list of
# environment variables to export before starting the services by hand.

# --- MySQL -----------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
# Password of the application user "food_delivery" that every service connects as
MYSQL_PASSWORD=

# --- Infrastructure credentials -------------------------------------------
CONFIG_SERVER_USER=config
CONFIG_SERVER_PASSWORD=
EUREKA_USER=eureka
EUREKA_PASSWORD=

# --- JWT -------------------------------------------------------------------
# Signs and verifies every token. At least 32 characters, random. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- First administrator (created by user-service if it does not exist yet) -
ADMIN_EMAIL=
ADMIN_PASSWORD=
